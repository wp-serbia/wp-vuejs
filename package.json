{
  "name": "wp-vuejs",
  "version": "2.0.1",
  "author": "Momir Despotović <despotovic.m@gmail.com> (https://web-studio.dev)",
  "description": "A simple Vue blog template that displays posts from any WordPress REST API endpoint.",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint ./src --fix",
    "precommit": "pretty-quick --staged",
    "prettier": "prettier --write \"./src/**/*.js\""
  },
  "bugs": {
    "url": "https://github.com/wp-serbia/wp-vuejs/issues"
  },
  "keywords": [
    "vue",
    "wordpress",
    "blog",
    "REST",
    "API"
  ],
  "homepage": "https://wp-vue-js.netlify.com",
  "dependencies": {
    "mitt": "^3.0.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17",
    "husky": "^9.1.7",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "pretty-quick": "^4.2.0",
    "sass": "^1.89.0",
    "vite": "^7.3.8",
    "vue-eslint-parser": "^10.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wp-serbia/wp-vuejs"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}